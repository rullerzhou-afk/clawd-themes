{
  "schemaVersion": 1,
  "name": "Doraemon",
  "author": "RyanChenJJH",
  "license": "CC BY-NC-SA 4.0",
  "version": "1.0.0",
  "description": "Full-featured Doraemon (机器猫) desktop pet with roam, reactions, gadgets, full sleep cycle and subagent events.",
  "viewBox": {
    "x": -20,
    "y": -25,
    "width": 50,
    "height": 50
  },
  "layout": {
    "contentBox": {
      "x": -8,
      "y": -12,
      "width": 26,
      "height": 30
    },
    "centerX": 5,
    "baselineY": 18,
    "visibleHeightRatio": 0.45,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": true,
    "states": [
      "idle"
    ],
    "eyeRatioX": 0.5,
    "eyeRatioY": 0.5,
    "maxOffset": 2.2,
    "bodyScale": 0.25,
    "shadowStretch": 0.12,
    "shadowShift": 0.25,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "5px 18px"
  },
  "states": {
    "idle": [
      "idle-follow.svg"
    ],
    "roam": [
      "roam.svg"
    ],
    "thinking": [
      "thinking.svg"
    ],
    "working": [
      "typing.svg"
    ],
    "sleeping": [
      "sleeping.svg"
    ],
    "attention": [
      "happy.svg"
    ],
    "error": [
      "error.svg"
    ],
    "yawning": [
      "yawning.svg"
    ],
    "dozing": [
      "dozing.svg"
    ],
    "collapsing": [
      "collapsing.svg"
    ],
    "waking": [
      "waking.svg"
    ],
    "notification": [
      "notification.svg"
    ],
    "sweeping": [
      "sweeping.svg"
    ],
    "carrying": [
      "carrying.svg"
    ],
    "juggling": [
      "juggling.svg"
    ]
  },
  "sleepSequence": {
    "mode": "full"
  },
  "workingTiers": [
    {
      "minSessions": 3,
      "file": "building.svg"
    },
    {
      "minSessions": 2,
      "file": "juggling.svg"
    },
    {
      "minSessions": 1,
      "file": "typing.svg"
    }
  ],
  "idleAnimations": [
    {
      "file": "idle-dorayaki.svg",
      "duration": 6000
    },
    {
      "file": "idle-pocket.svg",
      "duration": 6500
    }
  ],
  "reactions": {
    "drag": {
      "file": "react-drag.svg"
    },
    "clickLeft": {
      "file": "react-left.svg",
      "duration": 2500
    },
    "clickRight": {
      "file": "react-right.svg",
      "duration": 2500
    },
    "double": {
      "files": [
        "react-double.svg"
      ],
      "duration": 3500
    }
  },
  "hitBoxes": {
    "default": {
      "x": -6,
      "y": -10,
      "w": 22,
      "h": 28
    },
    "sleeping": {
      "x": -8,
      "y": 2,
      "w": 26,
      "h": 16
    }
  }
}
